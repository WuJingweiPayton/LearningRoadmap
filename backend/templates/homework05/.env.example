# Sepolia JSON-RPC (Infura, Alchemy, or publicnode)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Task 1 — send ETH (never commit real keys)
PRIVATE_KEY=0x

# Task 1 — transfer recipient
TRANSFER_TO=0x0000000000000000000000000000000000000001

# Task 1 — optional block number (empty = latest)
BLOCK_NUMBER=

# Task 1 — ETH amount for sendtx (default 0.0001)
TRANSFER_ETH=0.0001

# Task 2 — deploy | read | increment
COUNTER_ACTION=read

# Task 2 — deployed Counter on Sepolia
COUNTER_ADDRESS=0x